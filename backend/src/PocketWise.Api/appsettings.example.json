{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,
  "ConnectionStrings": {
    "Default": "Host=aws-0-ap-south-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-strong-password;SSL Mode=Require;Trust Server Certificate=true"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_STRONG_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG!",
    "Issuer": "PocketWiseApi",
    "Audience": "PocketWiseWeb",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://your-pocketwise-app.vercel.app"
    ]
  },
  "RecurringJob": {
    "IntervalMinutes": 60
  },
  "MaintenanceJobs": {
    "AuditLogCleanup": {
      "Enabled": true,
      "RetentionDays": 365,
      "RunHour": 2,
      "RunMinute": 0
    },
    "RefreshTokenCleanup": {
      "Enabled": true,
      "RunDayOfWeek": "Sunday",
      "RunHour": 3,
      "RunMinute": 0
    }
  },
  "SmtpSettings": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "your-email@gmail.com",
    "Password": "your-google-app-password",
    "FromEmail": "your-email@gmail.com",
    "FromDisplayName": "PocketWise"
  }
}
