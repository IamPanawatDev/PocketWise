{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/recurring",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 19 * * 0"
    }
  ]
}
